# Accounts context (spec §14)
ACCOUNTS_DATABASE_URL=postgres://oe:oe@localhost:5432/oe_accounts?sslmode=disable
NOTIFICATIONS_DATABASE_URL=postgres://oe:oe@localhost:5432/oe_notifications?sslmode=disable

# api process
HTTP_ADDR=:8080
ADMIN_ADDR=127.0.0.1:8081
LOG_LEVEL=info

# relay process (spec §14)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=accounts.user.v1
RELAY_BATCH_SIZE=100
RELAY_IDLE_MIN=50ms
RELAY_IDLE_MAX=2s
RELAY_BACKOFF_BASE=1s
RELAY_BACKOFF_CAP=5m
# An alert threshold, not a state transition: a row past it keeps retrying and is
# counted in the pass line's stuck_rows (spec §12.1, D8).
RELAY_MAX_ATTEMPTS=10
RELAY_USE_NOTIFY=true
PURGE_INTERVAL=1m
OUTBOX_RETENTION=24h
PURGE_BATCH=1000
